        )
    }
}
```

## Edge Case Testing

### Nil Handling

```swift
// ✅ Correct: Testing nil handling
func testMappingWithNilValues() {
    let entity = ClientEntity(...)
    entity.email = nil
    entity.phone = nil
    
    let domainModel = Client(from: entity)
    
    XCTAssertNil(domainModel.email)
    XCTAssertNil(domainModel.phone)
}
```

### Error Scenarios

```swift
// ✅ Correct: Testing error scenarios
func testRepositoryError() async {
    let mockRepository = MockRepository()
    mockRepository.shouldThrowError = true
    
    let useCase = FetchSessions(repository: mockRepository)
    
    do {
        _ = try await useCase.execute()
        XCTFail("Should have thrown error")
    } catch {
        XCTAssertTrue(error is RepositoryError)
    }
}
```

## Performance Testing

### Large Dataset Tests

```swift
// ✅ Correct: Performance test
func testMappingPerformance() {
    let entities = (0..<1000).map { _ in ClientEntity.testEntity() }
    
    measure {
        let domainModels = entities.map { Client(from: $0) }
        XCTAssertEqual(domainModels.count, entities.count)
    }
}
```

